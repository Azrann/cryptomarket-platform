@using CryptoMarketWeb.DataAccess.Entities
@using CryptoMarketWeb.Services
<!-- MAIN CONTENT -->
@{
    var icos = (List<IcoProject>)ViewBag.Icos;
    var icosSocialImpact = (Dictionary<int, IcoSocialImpact>)ViewBag.IcosSocialImpact;
}

<div id="content">
    <div class="row">
        <div class="col-xs-12 col-sm-7 col-md-7 col-lg-4">
            <h1 class="page-title txt-color-blueDark"><i class="fa-fw fa fa-bolt"></i> ICOs <span></span></h1>
        </div>
    </div>
    <!-- widget grid -->
    <section id="widget-grid" class="">

        <div class="row">
            <div class="col-sm-12">

                <div class="well">
                    <h1>
                        <span class="semi-bold">All ICOs as a list</span>
                    </h1>

                    <div class="btn-group btn-group-justified">
                        <a id="live" href="javascript:void(0);" class="btn btn-default btn-lg">Show Live ICOs</a>
                        <a id="upcomming" href="javascript:void(0);" class="btn btn-default btn-lg">Show Upcomming ICOs</a>
                    </div>
                </div>

            </div>
        </div>
        <!-- row -->
        <div class="row">
            <article class="col-sm-12">

                <!-- Widget ID (each widget will need unique ID)-->
                <div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-1" data-widget-editbutton="false">
                    <header>
                        <span class="widget-icon">
                            <i class="fa fa-table"></i>
                        </span>
                        <h2>ICOs</h2>
                    </header>

                    <!-- widget div-->
                    <div>

                        <!-- widget edit box -->
                        <div class="jarviswidget-editbox">
                        </div>
                        <!-- end widget edit box -->
                        <!-- widget content -->
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover" width="100%">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Rating Avg</th>
                                        <th>IcoHolder</th>
                                        <th>IcoBazar</th>
                                        <th>IcoBench</th>
                                        <th>Social Rating</th>
                                        <th>% Completed</th>
                                        <th>StartDate</th>
                                        <th>EndDate</th>
                                        <th>Upcomming</th>
                                        <th>Live</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var ico in icos)
                                {
                                    <tr>
                                        <td>
                                            <img src="@if (!ico.ProjImgFileName.Contains("data"))
                                                      {
                                                          @Html.Raw("/content/img/ico/");
                                                      }@ico.ProjImgFileName" width="16" height="16" /><a href="@Url.Action("Details", "Icos", new {icoName = ico.ProjName.Replace(".", "__").Replace(" ", "_")})"> @ico.ProjName</a>
                                                </td>
                                                <td>
                                                    @if (ico.RatingAvg == 0)
                {
                                    @Html.Raw("");
}
else
{
                                    @ico.RatingAvg
}
                                                </td>
                                                <td>
                                                    @if (ico.IcoHolderRating == 0)
                {
                                    @Html.Raw("")
;
}
else
{
                                    @ico.IcoHolderRating
}
                                                </td>
                                                <td>
                                                    @if (ico.IcoBazarRating == 0)
                {
                                    @Html.Raw("")
;
}
else
{
                                    @ico.IcoBazarRating
}
                                                </td>
                                                <td>
                                                    @if (ico.IcoBenchRating == 0)
                {
                                    @Html.Raw("")
;
}
else
{
                                    @ico.IcoBenchRating
}
                                                </td>
                                                <td>
                                                    @*@if (@icosSocialImpact.ContainsKey(ico.ProjName))
                    {
                        @icosSocialImpact[ico.ProjName].SocialImpact
                    }
                    else
                    {
                        @Html.Raw("0")
                    }*@
                                                </td>
                                                <td>
                                                    <div class="progress-bar progress-bar-@(@ico.Percent > 70 ? @Html.Raw("success") : @Html.Raw("primary"))" role="progressbar" style="width: @Math.Floor(@ico.Percent)%">@Math.Floor(@ico.Percent)%</div>
                                                </td>
                                                <td>
                                                    @{
                                                        @Html.Raw(@ico.EventStartDate.HasValue ? @ico.EventStartDate.Value.ToShortDateString() : "No data")
                    ;
                                                    }
                                                </td>
                                                <td>
                                                    @{
                                                        @Html.Raw(@ico.EventEndDate.HasValue ? @ico.EventEndDate.Value.ToShortDateString() : "No data")
                    ;
                                                    }
                                                </td>
                                                <td>
                                                    @Html.Raw(!@ico.EventStartDate.HasValue || (@ico.EventStartDate > @DateTime.UtcNow))
                                                </td>
                                                <td>
                                                    @Html.Raw(@ico.EventStartDate.HasValue && (@ico.EventStartDate < @DateTime.UtcNow)
                                                    && @ico.EventEndDate.HasValue && (@ico.EventEndDate > @DateTime.UtcNow))
                                                </td>
                                            </tr>
                                                }
                                </tbody>
                            </table>

                        </div>
                        <!-- end widget content -->

                    </div>
                    <!-- end widget div -->

                </div>
                <!-- end widget -->
            </article>
        </div>

        <!-- end row -->
    </section>
    <!-- end widget grid -->

</div>
<!-- END MAIN CONTENT -->

@section pagespecific {
    <script>
        $(document).ready(function() {


            /* BASIC ;*/
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                tablet: 1024,
                phone: 480
            };
            $('.read-more').click(function() {
                var originaltext = $(this).attr('data');
                $(this).parent().html(originaltext);
            });

           
            // custom toolbar
            $("div.toolbar")
                .html(
                    '<div class="text-right"><img src="/Content/img/logo.png" alt="SmartAdmin" style="width: 111px; margin-top: 3px; margin-right: 10px;"></div>');

            // custom css expression for a case-insensitive contains()
            jQuery.expr[':'].Contains = function(a, i, m) {
                return (a.textContent || a.innerText || "").toUpperCase().indexOf(m[3].toUpperCase()) >= 0;
            };

            /* COLUMN SHOW - HIDE */
            var otable = $('#datatable_col_reorder').DataTable({
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'f><'col-sm-6 col-xs-6 hidden-xs'C>r>" +
                    "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-sm-6 col-xs-12'p>>",
                "autoWidth": true,
                "preDrawCallback": function() {
                    // Initialize the responsive datatables helper once.
                    if (!responsiveHelper_datatable_col_reorder) {
                        responsiveHelper_datatable_col_reorder =
                            new ResponsiveDatatablesHelper($('#datatable_col_reorder'), breakpointDefinition);
                    }
                },
                "rowCallback": function(nRow) {
                    responsiveHelper_datatable_col_reorder.createExpandIcon(nRow);
                },
                "drawCallback": function(oSettings) {
                    responsiveHelper_datatable_col_reorder.respond();
                }
            });

            otable.column('9').visible(false);
            otable.column('10').visible(false);

            $("#live").on('click', function () {
                $(this).addClass("btn-info");
                $(this).removeClass("btn-default");
                $("#upcomming").removeClass("btn-info");
                $("#upcomming").addClass("btn-default");
                otable.column('9').search('').draw();
                otable.column('10').search('true').draw();
            });
            $("#upcomming").on('click', function () {
                $(this).addClass("btn-info");
                $(this).removeClass("btn-default");
                $("#live").removeClass("btn-info");
                $("#live").addClass("btn-default");
                otable.column('9').search('true').draw();
                otable.column('10').search('').draw();
            });
           
        });

    </script>
}