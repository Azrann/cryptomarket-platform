@using SimpleFeedReader
@{
    var News = (List<FeedItem>)ViewBag.News;

}
<div id="content">

    <!-- row -->
    <div class="row">

        <!-- col -->
        <div class="col-xs-12 col-sm-7 col-md-7 col-lg-4">
            <h1 class="page-title txt-color-blueDark">
                <!-- PAGE HEADER -->
                <i class="fa-fw fa fa-file-text-o"></i> ICO <span>
                    >
                    News
                </span>
            </h1>
        </div>
        <!-- end col -->

    </div>
    <!-- end row -->

    <div class="row">
    @foreach (var newsItem in News)
    {
        <div class="col-sm-6">

            <div class="well padding-10">

                <div class="row">
                    <div class="col-md-4">
                        <img src="@newsItem.Image" class="img-responsive" alt="img">
                        <ul class="list-inline padding-10">
                            <li>
                                <i class="fa fa-calendar"></i>
                                <a href="javascript:void(0);"> @newsItem.Date </a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-8 padding-left-0">
                        <h3 class="margin-top-0"><a href="@newsItem.Uri" target="_blank"> @newsItem.Title </a><br><small class="font-xs"><i><a href="javascript:void(0);">@newsItem.Author</a></i></small></h3>
                        <p>
                            @Html.Raw(newsItem.Summary)<br>
                        </p>
                        <a class="btn btn-primary" href="@newsItem.Uri" target="_blank"> Read more </a>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>

</div>